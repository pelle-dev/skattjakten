# Kopiera till .env.local och fyll i det du behöver. Allt är frivilligt.

# Nyckel till Claude (Anthropic). Saknas den används exempelfrågor och exempelledtrådar.
ANTHROPIC_API_KEY=

# Vilken Claude-modell som används för AI-förslag.
AI_MODEL=claude-opus-5-5

# Adressen som QR-koderna pekar på. Lämna tom så används adressen du öppnar appen med.
# Exempel när mobiler på samma wifi ska scanna: http://192.168.1.10:3000
PUBLIC_BASE_URL=

# Postgres-databas (krävs på Vercel). Lämna tom lokalt så används en fil.
DATABASE_URL=

# Var datan sparas lokalt utan databas. Standard är data/db.json.
DATA_FILE=
